# Spring Profile
SPRING_PROFILES_ACTIVE=prod

# Database
LOCAL_DB_URL=jdbc:mysql://<rds-endpoint>:3306/paylens?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Seoul
LOCAL_DB_USERNAME=<db-username>
LOCAL_DB_PASSWORD=<db-password>

# Swagger Server URL
SWAGGER_SERVER_URL=https://<alb-dns>

# Kakao OAuth
KAKAO_REST_API_KEY=<kakao-rest-api-key>
KAKAO_CLIENT_SECRET=<kakao-client-secret>
KAKAO_REDIRECT_URI=https://<alb-dns>/login/oauth2/code/kakao

# Google OAuth
GOOGLE_CLIENT_ID=<google-client-id>
GOOGLE_CLIENT_SECRET=<google-client-secret>
# GOOGLE_REDIRECT_URI=https://<alb-dns>/login/oauth2/code/google

# JWT
JWT_SECRET=<jwt-secret>
JWT_EXPIRATION=3600000
JWT_REFRESH_EXPIRATION=1209600000

# AWS S3
AWS_ACCESS_KEY=<aws-access-key>
AWS_SECRET_KEY=<aws-secret-key>
AWS_REGION=ap-northeast-2
AWS_S3_BUCKET=<s3-bucket-name>
AWS_S3_PATH=<s3-path-name>

# PORTONE
PORTONE_STORE_ID=<port-store-id>
PORTONE_API_KEY=<portone-api-key>
PORTONE_API_SECRET=<portone-api-secret>

# OCR FastAPI
OCR_FASTAPI_BASE_URL=https://<ocr-server-dns>
OCR_INTERNAL_TOKEN=<ocr-internal-token>
OCR_FASTAPI_TIMEOUT_SECONDS=180
